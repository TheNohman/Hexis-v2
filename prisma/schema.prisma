generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Auth (NextAuth) ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]

  // Hexis domain relations
  workouts         Workout[]
  exercises        Exercise[]
  workoutTemplates WorkoutTemplate[]
  bodyWeightEntries  BodyWeightEntry[]
  bodyMeasurements       BodyMeasurement[]
  measurementTypeConfigs MeasurementTypeConfig[]
  programs               Program[]
  wellnessLogs       WellnessLog[]
  exerciseMaxes      ExerciseMax[]
  mentorAdvices      MentorAdvice[]
  appEvents          AppEvent[]

  // Profile / preferences
  unitSystem       String   @default("metric") // "metric" | "imperial"
  defaultRestSecs  Int?     // repos par défaut en secondes
  bodyWeightKg     Float?   // dernier poids de corps connu
  mentorEnabled    Boolean  @default(false)     // active le mentor IA

  // Extracted 1:1 relations (see UserSportProfile / UserEnduranceRefs)
  sportProfile   UserSportProfile?
  enduranceRefs  UserEnduranceRefs?

  // Mentor advice cache
  lastAdvice       String?
  lastAdviceAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Sport profile filled at onboarding (primary sport, level, objective,
/// availability, equipment, medical notes). Split off from User to keep
/// the god-object slim: these fields are only read on the profile/mentor
/// paths, never on the hot auth path.
model UserSportProfile {
  id                    String        @id @default(cuid())
  userId                String        @unique
  primarySport          PrimarySport?
  sportLevel            SportLevel?
  sportObjective        String?
  weeklySessionTarget   Int?
  sessionDurationMins   Int?
  equipmentAccess       String[]      @default([])
  medicalNotes          String?
  onboardingCompletedAt DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Endurance reference values (used to derive HR / pace / power zones).
/// Split off from User for the same reason as UserSportProfile.
model UserEnduranceRefs {
  id        String   @id @default(cuid())
  userId    String   @unique
  fcMax     Int?
  fcResting Int?
  vmaKmh    Float?
  ftp       Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Hexis domain ----------

enum ExerciseType {
  STRENGTH // musculation avec charge
  BODYWEIGHT // poids de corps
  CARDIO // course, vélo, natation, rameur
  MOBILITY // étirements, mobilité
  REST // repos entre séries/intervalles
}

enum KpiDataType {
  INTEGER
  DECIMAL
  DURATION // stocké en secondes
  TEXT
}

enum EntryStatus {
  PLANNED // entrée prévue (créée depuis un template)
  DONE // validée par l'utilisateur
  SKIPPED // sautée
}

enum PrimarySport {
  STRENGTH_TRAINING // musculation classique (hypertrophie/esthétique/santé)
  POWERLIFTING      // powerlifting orienté force S+B+D
  ENDURANCE         // course, vélo, natation, triathlon
  CROSSFIT_HIIT     // CrossFit, HIIT, circuits intenses
  MULTI_SPORT       // mix non catégorisable
}

enum SportLevel {
  BEGINNER      // < 6 mois de pratique structurée
  INTERMEDIATE  // 6 mois - 2 ans
  ADVANCED      // 2+ ans, autonome
  COMPETITIVE   // pratique compétition
}

enum BlockMode {
  STANDARD   // bloc classique : séries avec poids/reps/RPE
  INTERVAL   // bloc d'intervalles : Tabata / HIIT chronométré
}

enum IntervalFormat {
  TABATA     // 20s/10s × 8 (preset)
  INTERVALS  // work/rest/rounds libres
  EMOM       // Every Minute On the Minute (V2)
  AMRAP      // As Many Rounds As Possible (V2)
}

enum PlaybackOrder {
  CYCLE    // A → B → C → A → B → C (playlist cyclée sur les rounds)
  SAME     // A × tous les rounds (Tabata pur 1 exo)
  CUSTOM   // séquence explicite par round (customSequence rempli)
}

enum MaxSource {
  MANUAL    // saisi explicitement par l'utilisateur (test 1RM)
  INFERRED  // détecté automatiquement à partir d'une séance
}

/// Configuration d'un bloc HIIT / intervalles (format, work/rest, rounds,
/// ordre de lecture, séquence custom…). Factorisée hors de WorkoutBlock et
/// WorkoutTemplateBlock pour éviter la duplication des 7 colonnes — chaque
/// bloc en mode INTERVAL possède son instance (relation 1:1, non partagée).
model IntervalConfig {
  id                String          @id @default(cuid())
  intervalFormat    IntervalFormat?
  workSecs          Int?
  restSecs          Int?
  roundCount        Int?
  playbackOrder     PlaybackOrder?  @default(CYCLE)
  countdownLeadSecs Int             @default(10)
  /// When playbackOrder=CUSTOM, one exerciseId per round. Length matches
  /// roundCount. Empty / null for CYCLE and SAME.
  customSequence    String[]        @default([])

  workoutBlock         WorkoutBlock?
  workoutTemplateBlock WorkoutTemplateBlock?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Référentiel de KPIs (poids, reps, durée, distance, allure, %VMA, etc.)
model KpiDefinition {
  id       String      @id @default(cuid())
  slug     String      @unique
  name     String
  unit     String?
  dataType KpiDataType

  exerciseKpis        ExerciseKpi[]
  entryValues         EntryKpiValue[]
  templateEntryValues TemplateEntryKpiValue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Exercice de référence (catalogue système ou custom utilisateur)
model Exercise {
  id          String       @id @default(cuid())
  slug        String
  name        String
  description String?      @db.Text
  type        ExerciseType
  isSystem    Boolean      @default(false)
  userId      String? // null => exercice système du catalogue

  user            User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseKpis    ExerciseKpi[]
  entries         WorkoutEntry[]
  templateEntries WorkoutTemplateEntry[]
  maxes           ExerciseMax[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, slug])
  @@index([userId])
  @@index([type])
  @@index([isSystem])
  @@index([isSystem, userId])
}

/// Liaison Exercise <-> KpiDefinition : quels KPIs sont pertinents pour cet exercice
model ExerciseKpi {
  id              String  @id @default(cuid())
  exerciseId      String
  kpiDefinitionId String
  isRequired      Boolean @default(true)
  displayOrder    Int     @default(0)

  exercise      Exercise      @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  kpiDefinition KpiDefinition @relation(fields: [kpiDefinitionId], references: [id], onDelete: Cascade)

  @@unique([exerciseId, kpiDefinitionId])
  @@index([exerciseId])
}

/// Une séance d'entraînement
model Workout {
  id         String    @id @default(cuid())
  userId     String
  name       String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  notes      String?   @db.Text
  templateId String? // si créée depuis un template

  // Programme lié (optionnel)
  programId     String?
  programSlotId String? // créneau du programme qui a généré cette séance

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  template WorkoutTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  program  Program?         @relation(fields: [programId], references: [id], onDelete: SetNull)
  blocks   WorkoutBlock[]
  prs      ExerciseMax[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([startedAt])
  @@index([templateId])
  @@index([programId])
}

/// Un bloc dans une séance (ex: "Haut du corps", "Fractionné 10K")
model WorkoutBlock {
  id           String @id @default(cuid())
  workoutId    String
  name         String
  displayOrder Int    @default(0)

  // Discriminant kept on the block for cheap filtering (no JOIN needed
  // to tell "is this a HIIT block?"). All other HIIT knobs live on the
  // optional IntervalConfig relation below.
  mode              BlockMode       @default(STANDARD)
  /// Live counter updated as the user completes rounds of the circuit.
  completedRounds   Int             @default(0)

  /// 1:1 optional relation holding the full HIIT configuration. Null for
  /// STANDARD blocks. Each WorkoutBlock owns its own IntervalConfig row
  /// (no sharing across blocks).
  intervalConfigId  String?         @unique
  intervalConfig    IntervalConfig? @relation(fields: [intervalConfigId], references: [id], onDelete: SetNull)

  workout Workout        @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  entries WorkoutEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workoutId])
}

/// Une entrée dans un bloc = une ligne (série de muscu, intervalle de course, repos...)
model WorkoutEntry {
  id               String      @id @default(cuid())
  blockId          String
  exerciseId       String
  displayOrder     Int         @default(0)
  status           EntryStatus @default(PLANNED)
  completedAt      DateTime?
  restDurationSecs Int? // repos prévu après cette entrée (hérité du template)

  notes            String?     @db.Text // notes par série (ex: "tempo 3-1-2")
  isWarmup         Boolean     @default(false) // série d'échauffement

  block    WorkoutBlock    @relation(fields: [blockId], references: [id], onDelete: Cascade)
  exercise Exercise        @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  values   EntryKpiValue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([blockId])
  @@index([exerciseId])
}

/// La valeur d'un KPI pour une entrée donnée (ex: 80kg, 10 reps, 120s)
model EntryKpiValue {
  id              String  @id @default(cuid())
  entryId         String
  kpiDefinitionId String
  valueNumeric    Float?
  valueText       String?
  plannedNumeric  Float? // valeur prévue par le template
  plannedText     String? // valeur prévue par le template

  entry         WorkoutEntry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  kpiDefinition KpiDefinition @relation(fields: [kpiDefinitionId], references: [id], onDelete: Restrict)

  @@unique([entryId, kpiDefinitionId])
  @@index([entryId])
}

// ---------- Templates ----------

/// Suivi du poids corporel
model BodyWeightEntry {
  id       String   @id @default(cuid())
  userId   String
  weightKg Float
  date     DateTime @db.Date
  notes    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}

/// Mesures corporelles (tour de taille, bras, etc.)
model BodyMeasurement {
  id     String   @id @default(cuid())
  userId String
  type   String   // slug du type de mesure
  value  Float    @map("value") // valeur dans l'unité du type
  date   DateTime @db.Date
  notes  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, type, date])
  @@index([userId, type])
  @@index([date])
}

/// Configuration des types de mesures corporelles par utilisateur
model MeasurementTypeConfig {
  id        String   @id @default(cuid())
  userId    String
  slug      String
  label     String
  unit      String   @default("cm")
  color     String?
  sortOrder Int      @default(0)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, slug])
  @@index([userId])
}

/// Template de séance réutilisable
model WorkoutTemplate {
  id          String         @id @default(cuid())
  userId      String
  name        String
  description String?        @db.Text // intention libre du modèle (alimente l'IA)
  tags        String[]       @default([]) // ex: ["push", "upper", "strength"]
  source      TemplateSource @default(MANUAL) // provenance — manuel, IA, clone
  isFavorite  Boolean        @default(false)

  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  blocks       WorkoutTemplateBlock[]
  workouts     Workout[] // séances créées à partir de ce template
  programSlots ProgramSlot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

enum TemplateSource {
  MANUAL
  AI
  CLONED
}

/// Bloc dans un template
model WorkoutTemplateBlock {
  id           String @id @default(cuid())
  templateId   String
  name         String
  displayOrder Int    @default(0)

  // Discriminant kept on the block for cheap filtering. Full HIIT config
  // lives on the IntervalConfig relation below (shared schema with
  // WorkoutBlock — see IntervalConfig).
  mode              BlockMode       @default(STANDARD)

  /// 1:1 optional relation holding the full HIIT configuration. Null for
  /// STANDARD blocks. Each template block owns its own IntervalConfig row.
  intervalConfigId  String?         @unique
  intervalConfig    IntervalConfig? @relation(fields: [intervalConfigId], references: [id], onDelete: SetNull)

  template WorkoutTemplate        @relation(fields: [templateId], references: [id], onDelete: Cascade)
  entries  WorkoutTemplateEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([templateId])
}

/// Entrée dans un bloc de template
model WorkoutTemplateEntry {
  id               String @id @default(cuid())
  blockId          String
  exerciseId       String
  displayOrder     Int    @default(0)
  restDurationSecs Int? // repos suggéré après cette entrée

  block    WorkoutTemplateBlock      @relation(fields: [blockId], references: [id], onDelete: Cascade)
  exercise Exercise                  @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  values   TemplateEntryKpiValue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([blockId])
  @@index([exerciseId])
}

/// Valeur KPI prévue dans un template
model TemplateEntryKpiValue {
  id              String  @id @default(cuid())
  entryId         String
  kpiDefinitionId String
  valueNumeric    Float?
  valueText       String?

  entry         WorkoutTemplateEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  kpiDefinition KpiDefinition        @relation(fields: [kpiDefinitionId], references: [id], onDelete: Restrict)

  @@unique([entryId, kpiDefinitionId])
  @@index([entryId])
}

// ---------- Programmes d'entraînement ----------

/// Programme d'entraînement cyclique
model Program {
  id            String    @id @default(cuid())
  userId        String
  name          String
  description   String?   @db.Text // intention libre du programme (alimente l'IA)
  cycleCount    Int       @default(1) // nombre de cycles dans le programme
  cycleDays     Int       @default(7) // nombre de jours par cycle (7 = semaine, 8+ = cycle custom)
  isActive      Boolean   @default(false)
  currentSlotId String? // pointeur vers le prochain créneau
  startDate     DateTime? @db.Date // date à laquelle commence le cycle 1 jour 1 (optionnelle)

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  slots       ProgramSlot[]
  workouts    Workout[]
  currentSlot ProgramSlot?  @relation("CurrentSlot", fields: [currentSlotId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// Un créneau dans un programme : cycle X, jour Y → template Z
/// Plusieurs créneaux possibles le même jour (matin + soir par ex.)
model ProgramSlot {
  id         String  @id @default(cuid())
  programId  String
  cycle      Int     // 0-indexed (0..cycleCount-1)
  day        Int     // 0-indexed (0..cycleDays-1)
  startTime  String? // heure de début "HH:mm" (ex: "18:00")
  label      String? // label optionnel : "Push", "Pull", etc.

  templateId String?

  program         Program          @relation(fields: [programId], references: [id], onDelete: Cascade)
  template        WorkoutTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  currentForProgram Program[]      @relation("CurrentSlot")

  @@index([programId])
}

// ---------- Suivi bien-être ----------

/// Journal de bien-être quotidien (pré-séance)
model WellnessLog {
  id     String   @id @default(cuid())
  userId String
  date   DateTime @db.Date
  mood   Int      // 1-5
  sleep  Int      // 1-5
  energy Int      // 1-5
  stress Int      // 1-5
  notes  String?  @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@index([userId])
}

/// Trace des PR (Personal Records) d'un utilisateur sur un exercice de
/// force. Une ligne est créée à chaque fois qu'un nouveau meilleur 1RM
/// estimé (formule Epley) est atteint, ou qu'un max manuel est saisi.
model ExerciseMax {
  id           String    @id @default(cuid())
  userId       String
  exerciseId   String
  weightKg     Float
  reps         Int       @default(1)
  /// 1RM estimé via Epley : weight * (1 + reps/30). Permet de comparer
  /// des perfs à reps variables (80 kg × 3 > 85 kg × 1 par exemple).
  estimated1RM Float
  achievedAt   DateTime  @default(now())
  /// Facultatif : la séance où ce PR a été atteint.
  workoutId    String?
  source       MaxSource @default(INFERRED)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise Exercise  @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  workout  Workout?  @relation(fields: [workoutId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId, exerciseId, achievedAt])
  @@index([userId, achievedAt])
}

/// Historique des conseils du Mentor IA. Chaque génération réussie
/// crée une ligne ; `User.lastAdvice` reste utilisé comme cache court.
model MentorAdvice {
  id        String   @id @default(cuid())
  userId    String
  content   String   @db.Text
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// Évènement applicatif (télémétrie in-app). `userId` peut être null
/// pour les events pré-auth. Le payload JSON reste libre pour évoluer
/// sans migration quand on ajoute des métadonnées.
model AppEvent {
  id        String   @id @default(cuid())
  userId    String?
  name      String
  payload   Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([name, createdAt])
}
